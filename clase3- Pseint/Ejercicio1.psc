Algoritmo ejemplo1
	// ===== Espacio para definir las variables
	Definir contador Como Entero
	
	Escribir "prueba con ciclo Para..."
	Para contador <- 1 Hasta 5	
		Escribir "Hola"
	FinPara
	
	Escribir "prueba con ciclo Mientras..."
	contador <- 1
	Mientras contador <= 5 Hacer
		Escribir "Hola"
		contador <- contador + 1
	FinMientras
	
	
FinAlgoritmo
